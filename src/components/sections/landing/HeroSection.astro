---
import ReservationEmail from "./reservation-email.astro";
import MobileReservationEmail from "./mobile-reservation-email";

const lang = Astro.currentLocale || "en";

const t = {
  en: {
    title1: "Where the Green meets the Blue,",
    title2: "a hidden paradise",
    title3: "at Mangal Beach Lodge!",
    description1: "Escape to a place where the ocean breeze, swaying palms, and untouched nature create the perfect and relaxing staying. Wake up to the sound of the birds, relax beneath native tropical trees, and discover our stunning Top Tree Deck with panoramic views of the mangroves and the breathtaking Bazaruto Archipelago.",
    description2: "Designed for comfort, surrounded by nature, and filled with tranquility, this is more than a stay, it’s an unforgettable experience.",
    location: "* Vilankulos, Inhambane, Mozambique",
    seeDirection: "See direction",
  },
  pt: {
    title1: "Onde o verde encontra o azul, um",
    title2: "paraíso escondido",
    title3: "no Mangal Beach Lodge!",
    description1:
      "Fuja para um lugar onde a brisa do oceano, as palmeiras ondulantes e a natureza intocada criam a estadia perfeita e relaxante. Acorde com o som dos pássaros, relaxe sob as árvores tropicais nativas e descubra o nosso deslumbrante Top Tree Deck com vistas panorâmicas sobre os mangais e o Arquipélago de Bazaruto.",
    description2:
      "Projetado para o conforto, cercado pela natureza e repleto de tranquilidade, esta é mais do que uma estadia, é uma experiência inesquecível.",
    location: "* Vilankulos, Inhambane, Moçambique",
    seeDirection: "Ver direções",
  },
}[lang as "en" | "pt"];
---

<section class="pt-8 pb-12 md:pt-12 lg:pt-16">
  <div
    class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(360px,0.9fr)] lg:items-end"
  >
    <div class="w-full">
      <h1
        class="max-w-4xl w-full text-5xl leading-[1.02] font-medium tracking-tight text-balance text-zinc-800 sm:text-6xl xl:text-6xl "
      >
        {t.title1}
        <span class="block text-amber-600">{t.title2}</span>
        <span class="block">{t.title3}</span>
      </h1>

      <img
        src="/sea.jpeg"
        alt="Mangal Beach Lodge entrance"
        class="mt-7 mr-20 ml-auto h-20 w-full max-w-72.5 rounded-full object-cover shadow-md sm:h-24 sm:max-w-85 lg:mr-auto"
        loading="lazy"
        decoding="async"
      />

      <div
        class="mt-6 max-w-md space-y-4 text-sm leading-relaxed text-pretty text-zinc-600 sm:max-w-xl sm:text-base"
      >
        <p>{t.description1}</p>
        <p>{t.description2}</p>
      </div>

      <div
        class="mt-10 flex flex-col gap-4 rounded-[1.75rem] bg-neutral-100 px-6 py-5 text-zinc-900 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="text-lg font-semibold sm:text-xl">
          {t.location}
        </p>

        <a
          href="#footer"
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-600 transition-colors hover:text-amber-600"
        >
          {t.seeDirection}
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M3.75 10H16.25M16.25 10L10 3.75M16.25 10L10 16.25"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <ReservationEmail />
    <div class="block md:hidden">
      <MobileReservationEmail client:only="react" />
    </div>
  </div>
</section>
