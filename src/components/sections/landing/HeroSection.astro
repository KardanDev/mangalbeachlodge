---
import ReservationEmail from "./reservation-email.astro";
import MobileReservationEmail from "./mobile-reservation-email";

const lang = Astro.currentLocale || "en";

const t = {
  en: {
    title1: "Premium beach lodging",
    title2: "in Inhambane,",
    title3: "Mozambique.",
    description:
      "Experience authentic Mozambican warmth right by the ocean in Vilankulos. Nestled in the Bazaruto Archipelago, Mangal Beach Lodge offers pristine white sands, crystal clear waters, and memories that will last a lifetime.",
    location: "* Vilankulos, Inhambane, Mozambique",
    seeDirection: "See direction",
  },
  pt: {
    title1: "Alojamento de praia premium",
    title2: "em Inhambane,",
    title3: "Moçambique.",
    description:
      "Experimente a autêntica hospitalidade moçambicana junto ao oceano em Vilankulos. Situado no Arquipélago de Bazaruto, o Mangal Beach Lodge oferece areias brancas imaculadas, águas cristalinas e memórias que durarão para sempre.",
    location: "* Vilankulos, Inhambane, Moçambique",
    seeDirection: "Ver direções",
  },
}[lang as "en" | "pt"];
---

<section class="pt-8 pb-12 md:pt-12 lg:pt-16">
  <div
    class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(360px,0.9fr)] lg:items-end"
  >
    <div>
      <h1
        class="max-w-3xl text-5xl leading-[1.02] font-medium tracking-tight text-balance text-zinc-800 sm:text-6xl xl:text-7xl"
      >
        {t.title1}
        <span class="block text-amber-600">{t.title2}</span>
        <span class="block">{t.title3}</span>
      </h1>

      <img
        src="/mangal-entrance.png"
        alt="Mangal Beach Lodge entrance"
        class="mt-7 mr-20 ml-auto h-20 w-full max-w-[290px] rounded-full object-cover shadow-md sm:h-24 sm:max-w-[340px] lg:mr-auto"
        loading="lazy"
        decoding="async"
      />

      <p
        class="mt-6 max-w-md text-sm leading-relaxed text-pretty text-zinc-600 sm:max-w-xl sm:text-base"
      >
        {t.description}
      </p>

      <div
        class="mt-10 flex flex-col gap-4 rounded-[1.75rem] bg-neutral-100 px-6 py-5 text-zinc-900 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="text-lg font-semibold sm:text-xl">
          {t.location}
        </p>

        <a
          href="#footer"
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-600 transition-colors hover:text-amber-600"
        >
          {t.seeDirection}
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M3.75 10H16.25M16.25 10L10 3.75M16.25 10L10 16.25"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <ReservationEmail />
    <div class="block md:hidden">
      <MobileReservationEmail client:only="react" />
    </div>
  </div>
</section>
