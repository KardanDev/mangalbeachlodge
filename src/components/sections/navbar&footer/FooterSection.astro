---
import BrandLogo from "@components/BrandLogo.astro";
import { SITE } from "@data/constants";

const lang = Astro.currentLocale || "en";

const t = {
  en: {
    desc: "Nestled on the coast of Vilankulos, Inhambane. Escape to the shores of the Bazaruto Archipelago and experience authentic Mozambican hospitality.",
    directions: "Directions",
    quickLinks: "Quick Links",
    rooms: "Our Rooms",
    facilities: "Facilities",
    about: "About Us",
    contact: "Contact",
    followUs: "Follow Us",
    rights: "All rights reserved.",
  },
  pt: {
    desc: "Situado na costa de Vilankulos, Inhambane. Fuja para as margens do Arquipélago de Bazaruto e experimente a autêntica hospitalidade moçambicana.",
    directions: "Direções",
    quickLinks: "Links Rápidos",
    rooms: "Nossos Quartos",
    facilities: "Instalações",
    about: "Sobre Nós",
    contact: "Contato",
    followUs: "Siga-nos",
    rights: "Todos os direitos reservados.",
  },
}[lang as "en" | "pt"];
---

<footer class="w-full bg-neutral-900 text-neutral-300">
  {/* Google Maps Embed */}
  <div class="h-80 w-full sm:h-96">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3697.4698614136423!2d35.3236601122722!3d-22.069866008416042!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1f2657f354c07103%3A0xb6596de1c83c9a62!2sMangal%20Beach%20Lodge!5e0!3m2!1sen!2sbr!4v1778094386696!5m2!1sen!2sbr"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>

  {/* Main Footer */}
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-16 2xl:max-w-(--breakpoint-2xl)"
  >
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4 lg:grid-cols-5">
      {/* Brand & Directions */}
      <div class="col-span-1 space-y-4 md:col-span-2 lg:col-span-2">
        <BrandLogo class="h-auto w-32 text-white" />
        <p class="max-w-xs text-sm leading-relaxed text-neutral-400">
          {t.desc}
        </p>
        <div class="text-sm text-neutral-400">
          <p class="font-medium text-neutral-200">{t.directions}</p>
          <p>Mangal Beach 1942 Vilanculos Inhambane</p>
          <p>Moçambique</p>
        </div>
      </div>

      {/* Quick Links */}
      <div class="col-span-1">
        <h3
          class="mb-4 text-sm font-bold tracking-wider text-neutral-100 uppercase"
        >
          {t.quickLinks}
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href="#rooms"
              class="inline-flex gap-x-2 text-sm text-neutral-400 transition hover:text-white"
              >{t.rooms}</a>
          </li>
          <li>
            <a
              href="#facilities"
              class="inline-flex gap-x-2 text-sm text-neutral-400 transition hover:text-white"
              >{t.facilities}</a>
          </li>
          <li>
            <a
              href="#about"
              class="inline-flex gap-x-2 text-sm text-neutral-400 transition hover:text-white"
              >{t.about}</a>
          </li>
          <li>
            <a
              href="#contact"
              class="inline-flex gap-x-2 text-sm text-neutral-400 transition hover:text-white"
              >{t.contact}</a>
          </li>
        </ul>
      </div>

      {/* Contact */}
      <div class="col-span-1">
        <h3
          class="mb-4 text-sm font-bold tracking-wider text-neutral-100 uppercase"
        >
          {t.contact}
        </h3>
        <ul class="space-y-3">
          <li class="text-sm text-neutral-400">+258 84 689 0382</li>
          <li class="text-sm text-neutral-400">management@mangal.co.mz</li>
        </ul>
      </div>

      {/* Social Links */}
      <div class="col-span-1">
        <h3
          class="mb-4 text-sm font-bold tracking-wider text-neutral-100 uppercase"
        >
          {t.followUs}
        </h3>
        <div class="flex items-center gap-4">
          <a
            href="#"
            class="text-neutral-400 transition hover:text-white"
            aria-label="Instagram"
          >
            <svg
              class="h-6 w-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href="#"
            class="text-neutral-400 transition hover:text-white"
            aria-label="Facebook"
          >
            <svg
              class="h-6 w-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-neutral-800 pt-8 md:flex-row"
    >
      <p class="text-sm text-neutral-500">
        © <span id="current-year"></span>
        {SITE.title}. {t.rights}
      </p>
    </div>
  </div>

  <script>
    const year = new Date().getFullYear();
    const element = document.getElementById("current-year");
    if (element) {
      element.innerText = year.toString();
    }
  </script>
</footer>
