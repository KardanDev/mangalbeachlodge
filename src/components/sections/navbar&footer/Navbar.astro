---
//Import relevant dependencies
import NavLink from "@components/ui/links/NavLink.astro";
import enStrings from "@utils/navigation.ts";
import ptStrings from "@utils/pt/navigation.ts";
import BrandLogo from "@components/BrandLogo.astro";
import LanguagePicker from "@components/ui/LanguagePicker.astro";
import ReservationButton from "@/components/ui/cta/ReservationButton.astro";

// Select the correct translation based on the page's lang prop:
const strings = Astro.currentLocale === "pt" ? ptStrings : enStrings;
const homeUrl = Astro.currentLocale === "pt" ? "/pt" : "/";
---

<!-- Main header component -->
<header
  class="z-50 flex w-full flex-wrap md:sticky md:inset-x-0 md:top-4 md:flex-nowrap md:justify-start"
>
  <!-- Navigation container -->
  <nav
    class="relative mx-auto w-full bg-white py-2 md:max-w-[85rem] md:rounded-2xl md:border md:border-white/20 md:bg-white/80 md:py-0 md:shadow-lg md:backdrop-blur-xl md:flex md:items-center md:justify-between md:px-6"
    aria-label="Global"
  >
    <div class="flex items-center justify-between px-4 md:px-0">
      <!-- Brand logo -->
      <a
        class="flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3"
        href={homeUrl}
        aria-label="Brand"
      >
        <BrandLogo class="h-auto w-24" />
      </a>
      <!-- Collapse toggle for smaller screens -->
      <div class="ml-auto md:hidden">
        <button
          type="button"
          class="hs-collapse-toggle flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-neutral-600 transition duration-300 hover:bg-neutral-200 disabled:pointer-events-none disabled:opacity-50"
          data-hs-collapse="#navbar-collapse-with-animation"
          aria-controls="navbar-collapse-with-animation"
          aria-label="Toggle navigation"
        >
          <svg
            class="hs-collapse-open:hidden h-5 w-5 shrink-0"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
          <svg
            class="hs-collapse-open:block hidden h-5 w-5 shrink-0"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <!-- ThemeIcon component specifically for smaller screens removed -->
    </div>
    <!-- Contains navigation links -->
    <div
      id="navbar-collapse-with-animation"
      class="hs-collapse relative hidden grow basis-full transition-all duration-300 md:block"
    >
      <!-- Navigation links container -->
      <div
        class="mt-4 flex flex-col gap-y-1 bg-white p-4 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-x-6 md:bg-transparent md:p-0 md:ps-7"
      >
        <!-- Navigation links and Authentication component -->
        {
          strings.navBarLinks.map((link) => (
            <NavLink url={link.url} name={link.name} />
          ))
        }

        <div class="my-2 h-px w-full bg-neutral-200 md:hidden"></div>

        <div class="px-2 md:px-0">
          <LanguagePicker />
        </div>
      </div>
    </div>
    <!-- <div class="hidden lg:block">
      <ReservationButton />
    </div> -->
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector(
      '[data-hs-collapse="#navbar-collapse-with-animation"]',
    );
    const menu = document.getElementById("navbar-collapse-with-animation");

    if (toggle && menu) {
      // Remove existing event listeners by cloning the node
      const newToggle = toggle.cloneNode(true) as HTMLElement;
      toggle.parentNode?.replaceChild(newToggle, toggle);

      newToggle.addEventListener("click", () => {
        // Toggle the menu visibility
        menu.classList.toggle("hidden");

        // Toggle the SVG icons (Hamburger and X)
        const svgs = newToggle.querySelectorAll("svg");
        if (svgs.length >= 2) {
          svgs[0].classList.toggle("hidden");
          svgs[1].classList.toggle("hidden");
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initMobileMenu);
  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>
